{
  "name": "claudeleaf",
  "version": "0.2.0",
  "description": "Bring Claude (and any agent) into Overleaf: a reliable bridge that drives the Overleaf web editor in real time via an SDK, CLI, and MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Louis Jannett",
  "keywords": [
    "overleaf",
    "latex",
    "mcp",
    "claude",
    "automation",
    "sharejs",
    "collaboration"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claudeleaf": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "claudeleaf": "tsx src/cli.ts",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.48.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
